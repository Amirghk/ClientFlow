# Copy to .env, then choose a local password. .env is ignored by Git.
POSTGRES_DB=clientflow
POSTGRES_USER=clientflow
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Auth0 public configuration. No client secret is used.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=

FRONTEND_PORT=5173
API_PORT=5080
# Optional Adminer database browser (--profile tools).
ADMINER_PORT=8081
